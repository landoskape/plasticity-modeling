\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Branch-specific STDP Model}  (\textbf  {A}) Additive STDP plasticity rule. Pre$\rightarrow $post pairings evoked potentiation, and post$\rightarrow $pre pairings evoked depression.  (\textbf  {B}) Homeostatic plasticity rule. Neurons adjusted all synapses multiplicatively in proportion to the log of the ratio between their current firing rate and their set point.   (\textbf  {C}) Branch-specific plasticity scheme. Each neuron we simulated had a proximal, distal-simple, and distal-complex compartment. The maximum allowed strength of synapses was high in proximal sites and low in both distal sites. We varied the amount of extra synaptic depression (LTD) in distal-complex branches.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:3}{{3}{4}{\textbf {Branch-specific STDP Model}\\ (\textbf {A}) Additive STDP plasticity rule. Pre$\rightarrow $post pairings evoked potentiation, and post$\rightarrow $pre pairings evoked depression.\\ (\textbf {B}) Homeostatic plasticity rule. Neurons adjusted all synapses multiplicatively in proportion to the log of the ratio between their current firing rate and their set point. \\ (\textbf {C}) Branch-specific plasticity scheme. Each neuron we simulated had a proximal, distal-simple, and distal-complex compartment. The maximum allowed strength of synapses was high in proximal sites and low in both distal sites. We varied the amount of extra synaptic depression (LTD) in distal-complex branches}{figure.caption.3}{}}
\newlabel{fig:3@cref}{{[figure][3][]3}{[1][3][]4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Strength of depression shapes input correlation properties}  (\textbf  {A}) Illustration of latent source model. A single autocorrelated latent source was generated. The dynamics of each input was partially determined by the latent source and partially by autocorrelated independent noise. The signal of each input is shown in color, and the difference from the latent source is shown by shading.  (\textbf  {B}) Resulting correlation matrix of all inputs (N=40) with correlation ranging from 0 to 0.4.   (\textbf  {C}) Total synaptic strength on each input in proximal (top), distal-simple (middle), and distal-complex (bottom) sites from a single recording. Each row represents the timecourse of synaptic weight on each presynaptic input source.   (\textbf  {D}) Average asymptotic synaptic strength as a function of input correlation. Weights were normalized to be relative to the maximum possible value. Color-coding follows \hyperref  [fig:3]{Figure 3c}, the color indicates the extra LTD magnitude in the distal-complex branch within each neuron.   (\textbf  {E}) Correlation of input source required to maintain a synaptic weight at 50\% of the maximum value for each branch type, denoted "$\sigma $ h-p". Middle inset: how the $\sigma $ h-p was measured. The level of extra depression in distal-complex sites had a large effect on $\sigma $ h-p locally, but did not affect proximal or distal-simple sites. }}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:4}{{4}{4}{\textbf {Strength of depression shapes input correlation properties}\\ (\textbf {A}) Illustration of latent source model. A single autocorrelated latent source was generated. The dynamics of each input was partially determined by the latent source and partially by autocorrelated independent noise. The signal of each input is shown in color, and the difference from the latent source is shown by shading.\\ (\textbf {B}) Resulting correlation matrix of all inputs (N=40) with correlation ranging from 0 to 0.4. \\ (\textbf {C}) Total synaptic strength on each input in proximal (top), distal-simple (middle), and distal-complex (bottom) sites from a single recording. Each row represents the timecourse of synaptic weight on each presynaptic input source. \\ (\textbf {D}) Average asymptotic synaptic strength as a function of input correlation. Weights were normalized to be relative to the maximum possible value. Color-coding follows \hyperref [fig:3]{Figure 3c}, the color indicates the extra LTD magnitude in the distal-complex branch within each neuron. \\ (\textbf {E}) Correlation of input source required to maintain a synaptic weight at 50\% of the maximum value for each branch type, denoted "$\sigma $ h-p". Middle inset: how the $\sigma $ h-p was measured. The level of extra depression in distal-complex sites had a large effect on $\sigma $ h-p locally, but did not affect proximal or distal-simple sites}{figure.caption.4}{}}
\newlabel{fig:4@cref}{{[figure][4][]4}{[1][3][]4}{}{}{}}
