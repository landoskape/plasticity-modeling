\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Mismatch in bAP-evoked calcium influx across dendritic branches.}  (\textbf  {A}) Schematic of naming scheme for dendritic branches. Distal-complex and distal-simple are defined based on the amplitude of $\Delta [Ca]_{AP}$.  (\textbf  {B}) Example of evoked calcium signals. $\Delta [Ca]_{amp}$ is measured as the difference between the calcium evoked by pairing a bAP with glutamate uncaging and the synthetic linear sum of each independently.   (\textbf  {C}) Left: average $\Delta [Ca]_{AP}$ traces in each compartment (compartments defined by $\Delta [Ca]_{AP}$ amplitude). Right: peak amplitude across dendritic branches.  (\textbf  {D}) Left: average relative $\Delta [Ca]_{amp}$ in each compartment. Relative signal measured as $\Delta [Ca]_{amp}/\Delta [Ca]_{glu}$ to account for variation in NMDAR activation. Right: peak amplitude across branches.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:1}{{1}{2}{\textbf {Mismatch in bAP-evoked calcium influx across dendritic branches.}\\ (\textbf {A}) Schematic of naming scheme for dendritic branches. Distal-complex and distal-simple are defined based on the amplitude of $\Delta [Ca]_{AP}$.\\ (\textbf {B}) Example of evoked calcium signals. $\Delta [Ca]_{amp}$ is measured as the difference between the calcium evoked by pairing a bAP with glutamate uncaging and the synthetic linear sum of each independently. \\ (\textbf {C}) Left: average $\Delta [Ca]_{AP}$ traces in each compartment (compartments defined by $\Delta [Ca]_{AP}$ amplitude). Right: peak amplitude across dendritic branches.\\ (\textbf {D}) Left: average relative $\Delta [Ca]_{amp}$ in each compartment. Relative signal measured as $\Delta [Ca]_{amp}/\Delta [Ca]_{glu}$ to account for variation in NMDAR activation. Right: peak amplitude across branches}{figure.caption.1}{}}
