@article{gaoCorticocerebellarLoopMotor2018,
  title = {A Cortico-Cerebellar Loop for Motor Planning},
  author = {Gao, Zhenyu and Davis, Courtney and Thomas, Alyse M. and Economo, Michael N. and Abrego, Amada M. and Svoboda, Karel and De Zeeuw, Chris I. and Li, Nuo},
