  langid = {english},
  keywords = {Humanities and Social Sciences,multidisciplinary,Science},
  file = {/Users/landauland/Zotero/storage/XYHWSZNC/Froemke et al. - 2005 - Spike-timing-dependent synaptic plasticity depends on dendritic location.pdf}
