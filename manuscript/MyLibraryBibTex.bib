  author = {Tripathy, Shreejoy J. and Padmanabhan, Krishnan and Gerkin, Richard C. and Urban, Nathaniel N.},
  year = 2013,
  month = may,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {110},
