@article{pellicer-callerInfluenceExogenousFactors2023,
  title = {Influence of {{Exogenous Factors Related}} to {{Nutritional}} and {{Hydration Strategies}} and {{Environmental Conditions}} on {{Fatigue}} in {{Endurance Sports}}: {{A Systematic Review}} with {{Meta-Analysis}}},
  shorttitle = {Influence of {{Exogenous Factors Related}} to {{Nutritional}} and {{Hydration Strategies}} and {{Environmental Conditions}} on {{Fatigue}} in {{Endurance Sports}}},
  author = {{Pellicer-Caller}, Roberto and {Vaquero-Crist{\'o}bal}, Raquel and {Gonz{\'a}lez-G{\'a}lvez}, Noelia and {Abenza-Cano}, Luc{\'i}a and Horcajo, Javier and {de la Vega-Marcos}, Ricardo},
  year = 2023,
  month = jan,
  journal = {Nutrients},
  volume = {15},
  number = {12},
  pages = {2700},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2072-6643},
  doi = {10.3390/nu15122700},
  urldate = {2025-08-28},
  abstract = {The aim of this systematic review with meta-analysis was to examine the influence of exogenous factors related to nutritional and hydration strategies and environmental conditions, as modulators of fatigue, including factors associated with performance fatigability and perceived fatigability, in endurance tests lasting 45 min to 3 h. A search was carried out using four databases: PubMed, Web of Science, SPORTDiscus, and EBSCO. A total of 5103 articles were screened, with 34 included in the meta-analysis. The review was registered with PROSPERO (CRD42022327203) and adhered to the PRISMA guidelines. The study quality was evaluated according to the PEDro score and assessed using Rosenthal's fail-safe N. Carbohydrate (CHO) intake increased the time to exhaustion (p {$<$} 0.001) and decreased the heart rate (HR) during the test (p = 0.018). Carbohydrate with protein intake (CHO + PROT) increased lactate during the test (p = 0.039). With respect to hydration, dehydrated individuals showed a higher rate of perceived exertion (RPE) (p = 0.016) and had a higher body mass loss (p = 0.018). In hot conditions, athletes showed significant increases in RPE (p {$<$} 0.001), HR (p {$<$} 0.001), and skin temperature (p = 0.002), and a decrease in the temperature gradient (p {$<$} 0.001) after the test. No differences were found when athletes were subjected to altitude or cold conditions. In conclusion, the results revealed that exogenous factors, such as nutritional and hydration strategies, as well as environmental conditions, affected fatigue in endurance sports, including factors associated with performance fatigability and perceived fatigability.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {endurance,environmental conditions,exogenous factors,fatigue,nutrition,sport},
  file = {/Users/landauland/Zotero/storage/TVT34KAE/Pellicer-Caller et al. - 2023 - Influence of Exogenous Factors Related to Nutritional and Hydration Strategies and Environmental Con.pdf}
}

@article{pembertonCerebellardrivenCorticalDynamics2024,
  title = {Cerebellar-Driven Cortical Dynamics Can Enable Task Acquisition, Switching and Consolidation},
  author = {Pemberton, Joseph and Chadderton, Paul and Costa, Rui Ponte},
  year = 2024,
  month = dec,
  journal = {Nature Communications},
  volume = {15},
  number = {1},
  pages = {10913},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-024-55315-6},
  urldate = {2025-09-04},
  abstract = {The brain must maintain a stable world model while rapidly adapting to the environment, but the underlying mechanisms are not known. Here, we posit that cortico-cerebellar loops play a key role in this process. We introduce a computational model of cerebellar networks that learn to drive cortical networks with task-outcome predictions. First, using sensorimotor tasks, we show that cerebellar feedback in the presence of stable cortical networks is sufficient for rapid task acquisition and switching. Next, we demonstrate that, when trained in working memory tasks, the cerebellum can also underlie the maintenance of cognitive-specific dynamics in the cortex, explaining a range of optogenetic and behavioural observations. Finally, using our model, we introduce a systems consolidation theory in which task information is gradually transferred from the cerebellum to the cortex. In summary, our findings suggest that cortico-cerebellar loops are an important component of task acquisition, switching, and consolidation in the brain.},
  copyright = {2024 The Author(s)},
  langid = {english},
  keywords = {Learning algorithms,Network models},
  file = {/Users/landauland/Zotero/storage/7NXREJET/Pemberton et al. - 2024 - Cerebellar-driven cortical dynamics can enable task acquisition, switching and consolidation.pdf}
}

@article{pengMorphologicalDiversitySingle2021,
  title = {Morphological Diversity of Single Neurons in Molecularly Defined Cell Types},
  author = {Peng, Hanchuan and Xie, Peng and Liu, Lijuan and Kuang, Xiuli and Wang, Yimin and Qu, Lei and Gong, Hui and Jiang, Shengdian and Li, Anan and Ruan, Zongcai and Ding, Liya and Yao, Zizhen and Chen, Chao and Chen, Mengya and Daigle, Tanya L. and Dalley, Rachel and Ding, Zhangcan and Duan, Yanjun and Feiner, Aaron and He, Ping and Hill, Chris and Hirokawa, Karla E. and Hong, Guodong and Huang, Lei and Kebede, Sara and Kuo, Hsien-Chi and Larsen, Rachael and Lesnar, Phil and Li, Longfei and Li, Qi and Li, Xiangning and Li, Yaoyao and Li, Yuanyuan and Liu, An and Lu, Donghuan and Mok, Stephanie and Ng, Lydia and Nguyen, Thuc Nghi and Ouyang, Qiang and Pan, Jintao and Shen, Elise and Song, Yuanyuan and Sunkin, Susan M. and Tasic, Bosiljka and Veldman, Matthew B. and Wakeman, Wayne and Wan, Wan and Wang, Peng and Wang, Quanxin and Wang, Tao and Wang, Yaping and Xiong, Feng and Xiong, Wei and Xu, Wenjie and Ye, Min and Yin, Lulu and Yu, Yang and Yuan, Jia and Yuan, Jing and Yun, Zhixi and Zeng, Shaoqun and Zhang, Shichen and Zhao, Sujun and Zhao, Zijun and Zhou, Zhi and Huang, Z. Josh and Esposito, Luke and Hawrylycz, Michael J. and Sorensen, Staci A. and Yang, X. William and Zheng, Yefeng and Gu, Zhongze and Xie, Wei and Koch, Christof and Luo, Qingming and Harris, Julie A. and Wang, Yun and Zeng, Hongkui},
  year = 2021,
  month = oct,
  journal = {Nature},
  volume = {598},
  number = {7879},
  pages = {174--181},
  publisher = {Nature Publishing Group},
  issn = {1476-4687},
  doi = {10.1038/s41586-021-03941-1},
  urldate = {2025-08-28},
  abstract = {Dendritic and axonal morphology reflects the input and output of neurons and is a defining feature of neuronal types1,2, yet our knowledge of its diversity remains limited. Here, to systematically examine complete single-neuron morphologies on a brain-wide scale, we established a pipeline encompassing sparse labelling, whole-brain imaging, reconstruction, registration and analysis. We fully reconstructed 1,741 neurons from cortex, claustrum, thalamus, striatum and other brain regions in mice. We identified 11 major projection neuron types with distinct morphological features and corresponding transcriptomic identities. Extensive projectional diversity was found within each of these major types, on the basis of~which some types were clustered into more refined subtypes. This diversity follows a set of generalizable principles that govern long-range axonal projections at different levels, including molecular correspondence, divergent or convergent projection, axon termination pattern, regional specificity, topography, and individual cell variability. Although clear concordance with transcriptomic profiles is evident at the level of~major projection type, fine-grained morphological diversity often does not readily correlate with transcriptomic subtypes derived from unsupervised clustering, highlighting the need for single-cell cross-modality studies. Overall, our study demonstrates the crucial need for quantitative description of complete single-cell anatomy in cell-type classification, as single-cell morphological diversity reveals a plethora of ways in which~different cell types and their individual members may contribute to the configuration and function of their respective circuits.},
  copyright = {2021 The Author(s)},
  langid = {english},
  keywords = {Cellular neuroscience,Neural circuits},
  file = {/Users/landauland/Zotero/storage/7FBDMG73/Peng et al. - 2021 - Morphological diversity of single neurons in molecularly defined cell types.pdf}
}

@article{perez-nievesNeuralHeterogeneityPromotes2021,
  title = {Neural Heterogeneity Promotes Robust Learning},
  author = {{Perez-Nieves}, Nicolas and Leung, Vincent C. H. and Dragotti, Pier Luigi and Goodman, Dan F. M.},
  year = 2021,
  month = oct,
  journal = {Nature Communications},
  volume = {12},
  number = {1},
  pages = {5791},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-021-26022-3},
  urldate = {2025-08-22},
  abstract = {The brain is a hugely diverse, heterogeneous structure. Whether or not heterogeneity at the neural level plays a functional role remains unclear, and has been relatively little explored in models which are often highly homogeneous. We compared the performance of spiking neural networks trained to carry out tasks of real-world difficulty, with varying degrees of heterogeneity, and found that heterogeneity substantially improved task performance. Learning with heterogeneity was more stable and robust, particularly for tasks with a rich temporal structure. In addition, the distribution of neuronal parameters in the trained networks is similar to those observed experimentally. We suggest that the heterogeneity observed in the brain may be more than just the byproduct of noisy processes, but rather may serve an active and important role in allowing animals to learn in changing environments.},
  copyright = {2021 The Author(s)},
  langid = {english},
  keywords = {Electrical and electronic engineering,Learning algorithms,Network models},
  file = {/Users/landauland/Zotero/storage/ER5CWNY3/Perez-Nieves et al. - 2021 - Neural heterogeneity promotes robust learning.pdf}
}

